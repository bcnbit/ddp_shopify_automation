###############################################################################
# Shopify Product Studio — plantilla de entorno
#
# Copia este archivo a `.env` y rellena los valores locales.
# NUNCA versiones un `.env` real ni escribas secretos en este archivo.
# Todos los valores sensibles se leen de variables de entorno y nunca se
# persisten en base de datos ni se envían al navegador (RFC-0000 / RFC-0001).
###############################################################################

APP_NAME="Shopify Product Studio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Madrid
APP_URL=http://localhost:8000

###############################################################################
# Idioma
#
# El contenido de producto se genera inicialmente en español (RFC-0000).
# La aplicación está pensada para una operadora no técnica hispanohablante.
###############################################################################

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

###############################################################################
# Mantenimiento y logs
#
# LOG_LEVEL=debug en local; usar `warning` o superior en producción para no
# arrastrar HTML ni prompts a los logs (RFC-0001).
###############################################################################

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###############################################################################
# Base de datos — MySQL 8
#
# En la suite de pruebas se usa SQLite en memoria (ver phpunit.xml).
###############################################################################

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shopify_product_studio
DB_USERNAME=root
DB_PASSWORD=

###############################################################################
# Sesiones
###############################################################################

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

###############################################################################
# Redis y colas
#
# Redis es el transporte de colas previsto en producción (RFC-0001).
# REDIS_CLIENT=predis porque la extensión phpredis no está disponible en
# entornos Windows con Laragon; en servidores Linux puede usarse phpredis.
#
# QUEUE_CONNECTION=database permite trabajar en local sin Redis arrancado.
###############################################################################

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=product_studio
REDIS_PERSISTENT=false

QUEUE_CONNECTION=database
PRODUCT_STUDIO_QUEUE_CONNECTION=database
PRODUCT_STUDIO_QUEUE_GENERATION=ai
PRODUCT_STUDIO_QUEUE_SYNC=shopify
PRODUCT_STUDIO_QUEUE_MEDIA=media
PRODUCT_STUDIO_QUEUE_TRIES=3
PRODUCT_STUDIO_PRODUCT_LOCK_SECONDS=900

CACHE_STORE=database
CACHE_PREFIX=product_studio

###############################################################################
# Almacenamiento de medios
#
# El disco `media` guarda los originales y no se limpia nunca.
# El disco `media-derived` guarda miniaturas y copias optimizadas.
# En producción puede usarse un endpoint S3-compatible (RFC-0007).
###############################################################################

FILESYSTEM_DISK=local
PRODUCT_STUDIO_MEDIA_DRIVER=local
PRODUCT_STUDIO_DERIVED_DRIVER=local
PRODUCT_STUDIO_MEDIA_DISK=media
PRODUCT_STUDIO_DERIVED_DISK=media-derived
PRODUCT_STUDIO_MEDIA_MAX_KB=20480
PRODUCT_STUDIO_MEDIA_MIN_WIDTH=800
PRODUCT_STUDIO_MEDIA_MIN_HEIGHT=800
PRODUCT_STUDIO_MEDIA_MAX_WIDTH=10000
PRODUCT_STUDIO_MEDIA_MAX_HEIGHT=10000
PRODUCT_STUDIO_MEDIA_MAX_PER_PRODUCT=20
PRODUCT_STUDIO_THUMBNAIL_WIDTH=400
PRODUCT_STUDIO_THUMBNAIL_HEIGHT=400
PRODUCT_STUDIO_THUMBNAIL_QUALITY=80
PRODUCT_STUDIO_OPTIMIZED_MAX_WIDTH=2048
PRODUCT_STUDIO_OPTIMIZED_MAX_HEIGHT=2048
PRODUCT_STUDIO_OPTIMIZED_QUALITY=85

# S3-compatible (opcional; vacío en local)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_BUCKET_MEDIA=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

###############################################################################
# Dominio de producto
###############################################################################

PRODUCT_STUDIO_DEFAULT_LOCALE=es
PRODUCT_STUDIO_INVENTORY_POLICY=deny
PRODUCT_STUDIO_SEO_TITLE_MIN=50
PRODUCT_STUDIO_SEO_TITLE_MAX=60
PRODUCT_STUDIO_SEO_DESCRIPTION_MIN=140
PRODUCT_STUDIO_SEO_DESCRIPTION_MAX=160
PRODUCT_STUDIO_TAGS_MIN=5
PRODUCT_STUDIO_TAGS_MAX=12
PRODUCT_STUDIO_MAX_GENERATIONS_PER_DAY=10

###############################################################################
# Seguridad
#
# REQUIRE_2FA_FOR_ADMINS exige segundo factor a los administradores técnicos
# (RFC-0001). APP_KEY cifra el secreto TOTP y los campos cifrados a nivel de
# aplicación: si se rota APP_KEY hay que reconfigurar el 2FA de cada admin.
###############################################################################

PRODUCT_STUDIO_REQUIRE_2FA_FOR_ADMINS=true

###############################################################################
# Shopify Admin GraphQL API — NO IMPLEMENTADO EN RFC-0001
#
# Placeholders para RFC-0004. No existe todavía ningún cliente ni llamada.
# Usar una aplicación personalizada con token restringido y scopes mínimos:
# productos (lectura/escritura), archivos y publicaciones.
# El token vive sólo en backend; nunca se persiste en tablas ni en logs.
###############################################################################

SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01
SHOPIFY_TIMEOUT=30

###############################################################################
# IA mediante OpenRouter — NO IMPLEMENTADO TODAVÍA
#
# La integración real corresponde a RFC-0003. OpenRouter expone una API
# compatible con la de OpenAI, así que el cliente se encapsula detrás de una
# interfaz propia y ninguna pantalla llama al proveedor directamente.
#
# El modelo usa el formato `proveedor/modelo` de OpenRouter, por ejemplo:
#   openai/gpt-4.1
#   anthropic/claude-sonnet-4
#   google/gemini-2.5-pro
# Cambiarlo no requiere tocar código.
#
# La clave se obtiene en https://openrouter.ai/keys y NUNCA se versiona ni se
# guarda en base de datos. No registrar prompts con imágenes ni respuestas
# completas (ver SecretRedactor).
###############################################################################

AI_DRIVER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4.1
OPENROUTER_TIMEOUT=120
OPENROUTER_CONNECT_TIMEOUT=10
OPENROUTER_RETRY_TIMES=2
OPENROUTER_RETRY_BACKOFF_MS=1000
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_TEMPERATURE=0.4

# Cabeceras de atribución de OpenRouter (no son credenciales).
OPENROUTER_APP_NAME="Shopify Product Studio"
OPENROUTER_APP_URL="${APP_URL}"

###############################################################################
# Correo
###############################################################################

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@diesdeplatja.test"
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# Frontend (Vite)
###############################################################################

VITE_APP_NAME="${APP_NAME}"