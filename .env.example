###############################################################################
# Shopify Product Studio — plantilla de entorno
#
# Copia este archivo a `.env` y rellena los valores locales.
# NUNCA versiones un `.env` real ni escribas secretos en este archivo.
# Todos los valores sensibles se leen de variables de entorno y nunca se
# persisten en base de datos ni se envían al navegador (RFC-0000 / RFC-0001).
###############################################################################

APP_NAME="Shopify Product Studio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Madrid
APP_URL=http://localhost:8000

###############################################################################
# Idioma
#
# El contenido de producto se genera inicialmente en español (RFC-0000).
# La aplicación está pensada para una operadora no técnica hispanohablante.
###############################################################################

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

###############################################################################
# Mantenimiento y logs
#
# LOG_LEVEL=debug en local; usar `warning` o superior en producción para no
# arrastrar HTML ni prompts a los logs (RFC-0001).
###############################################################################

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###############################################################################
# Base de datos — MySQL 8
#
# En la suite de pruebas se usa SQLite en memoria (ver phpunit.xml).
###############################################################################

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shopify_product_studio
DB_USERNAME=root
DB_PASSWORD=

###############################################################################
# Sesiones
###############################################################################

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

###############################################################################
# Redis y colas
#
# Redis es el transporte de colas previsto en producción (RFC-0001).
# REDIS_CLIENT=predis porque la extensión phpredis no está disponible en
# entornos Windows con Laragon; en servidores Linux puede usarse phpredis.
#
# QUEUE_CONNECTION=database permite trabajar en local sin Redis arrancado.
###############################################################################

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=product_studio
REDIS_PERSISTENT=false

QUEUE_CONNECTION=database
PRODUCT_STUDIO_QUEUE_CONNECTION=database
PRODUCT_STUDIO_QUEUE_GENERATION=ai
PRODUCT_STUDIO_QUEUE_SYNC=shopify
PRODUCT_STUDIO_QUEUE_MEDIA=media
PRODUCT_STUDIO_QUEUE_TRIES=3
PRODUCT_STUDIO_PRODUCT_LOCK_SECONDS=900

CACHE_STORE=database
CACHE_PREFIX=product_studio

###############################################################################
# Almacenamiento de medios
#
# El disco `media` guarda los originales y no se limpia nunca.
# El disco `media-derived` guarda miniaturas y copias optimizadas.
# En producción puede usarse un endpoint S3-compatible (RFC-0007).
###############################################################################

FILESYSTEM_DISK=local
PRODUCT_STUDIO_MEDIA_DRIVER=local
PRODUCT_STUDIO_DERIVED_DRIVER=local
# Discos de medios (RFC-0001 / RFC-0005 / RFC-0007).
#
# `media` = originales en disco local del servidor. `media-derived` = miniaturas.
# Para almacenar en un bucket, usa `media-s3` (originales) y deja los derivados
# donde prefieras. El cambio afecta sólo a los archivos NUEVOS: cada fila de
# `product_media` guarda el disco con el que se subió, así que lo ya subido sigue
# leyéndose de donde está.
PRODUCT_STUDIO_MEDIA_DISK=media
PRODUCT_STUDIO_DERIVED_DISK=media-derived

###############################################################################
# Almacenamiento en bucket S3 (RFC-0007)
#
# Para evitar el límite de subida del hosting hay que mover **dos** cosas:
#
#   1. Los originales: PRODUCT_STUDIO_MEDIA_DISK=media-s3
#   2. La subida temporal de Livewire: LIVEWIRE_TEMPORARY_UPLOAD_DISK=s3
#
# El segundo es el que de verdad quita el límite: con un disco S3, el navegador
# sube el archivo DIRECTO al bucket con una URL firmada y no pasa por PHP, así que
# `upload_max_filesize` y `post_max_size` dejan de aplicar. Si sólo se cambia el
# primero, el archivo sigue subiendo al servidor y el problema continúa igual.
#
# El bucket debe ser PRIVADO: los originales no deben ser legibles sin firma. El
# panel los muestra con URLs temporales.
###############################################################################

# Disco de las subidas temporales de Livewire. `s3` = directo al bucket.
# Vacío = disco por defecto (`FILESYSTEM_DISK`), es decir, subida contra el servidor.
LIVEWIRE_TEMPORARY_UPLOAD_DISK=

# Ventana de validez de la URL firmada, en minutos. Con subidas directas un valor
# corto produce un 403 de S3 a mitad de subida; el navegador lo muestra como un
# fallo genérico.
LIVEWIRE_MAX_UPLOAD_TIME=15

# Credenciales del bucket. Deja estos valores VACÍOS en el repositorio.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1

# Bucket de las subidas temporales de Livewire.
AWS_BUCKET=

# Bucket de los originales de producto (puede ser el mismo).
AWS_BUCKET_MEDIA=

# Los dos discos aceptan la otra variable como respaldo: si sólo defines una, los
# dos usan esa. Aun así, lo más claro es rellenar LAS DOS con el mismo nombre de
# bucket, o dejar una SIN la línea (no vacía): una variable presente y vacía es la
# causa de que una firma acabe sin bucket.

# Sólo para un CDN delante del bucket (CloudFront, R2). Sin él, Laravel firma
# contra la URL de S3 directamente.
AWS_URL=
AWS_TEMPORARY_URL=

# Para proveedores compatibles con S3: Cloudflare R2, Backblaze B2, MinIO.
# Ejemplo R2: https://<cuenta>.r2.cloudflarestorage.com
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
PRODUCT_STUDIO_MEDIA_MAX_KB=20480
PRODUCT_STUDIO_MEDIA_MIN_WIDTH=800
PRODUCT_STUDIO_MEDIA_MIN_HEIGHT=800
PRODUCT_STUDIO_MEDIA_MAX_WIDTH=10000
PRODUCT_STUDIO_MEDIA_MAX_HEIGHT=10000
PRODUCT_STUDIO_MEDIA_MAX_PER_PRODUCT=20
PRODUCT_STUDIO_THUMBNAIL_WIDTH=400
PRODUCT_STUDIO_THUMBNAIL_HEIGHT=400
PRODUCT_STUDIO_THUMBNAIL_QUALITY=80
PRODUCT_STUDIO_OPTIMIZED_MAX_WIDTH=2048
PRODUCT_STUDIO_OPTIMIZED_MAX_HEIGHT=2048
PRODUCT_STUDIO_OPTIMIZED_QUALITY=85

# S3-compatible (opcional; vacío en local)


###############################################################################
# Dominio de producto
###############################################################################

PRODUCT_STUDIO_DEFAULT_LOCALE=es
PRODUCT_STUDIO_INVENTORY_POLICY=deny

# Stock inicial de las tallas del botón «Añadir Variante Tallas».
# NO dejar vacío: una variable definida pero vacía anula el valor por defecto
# del código (handoff.md §2). Para desactivarlo, comentar la línea.
PRODUCT_STUDIO_INITIAL_INVENTORY_QUANTITY=5
PRODUCT_STUDIO_SEO_TITLE_MIN=50
PRODUCT_STUDIO_SEO_TITLE_MAX=60
PRODUCT_STUDIO_SEO_DESCRIPTION_MIN=140
PRODUCT_STUDIO_SEO_DESCRIPTION_MAX=160
PRODUCT_STUDIO_TAGS_MIN=5
PRODUCT_STUDIO_TAGS_MAX=12
PRODUCT_STUDIO_MAX_GENERATIONS_PER_DAY=10

###############################################################################
# Seguridad
#
# REQUIRE_2FA_FOR_ADMINS exige segundo factor a los administradores técnicos
# (RFC-0001). APP_KEY cifra el secreto TOTP y los campos cifrados a nivel de
# aplicación: si se rota APP_KEY hay que reconfigurar el 2FA de cada admin.
###############################################################################

PRODUCT_STUDIO_REQUIRE_2FA_FOR_ADMINS=true

# Administrador técnico inicial (RFC-0007 / RFC-0010).
#
# Los usa `AdminUserSeeder` al crear o resetear la cuenta con más privilegios.
#
# PRODUCT_STUDIO_ADMIN_PASSWORD vacía = el seeder genera una aleatoria y la muestra
# una sola vez por consola. Si ya existe un administrador y no defines contraseña,
# el seeder NO cambia nada (no deja fuera a quien ya entraba).
#
# Para fijar o resetear una contraseña conocida (mínimo 12 caracteres):
#   PRODUCT_STUDIO_ADMIN_PASSWORD=...
#   php artisan db:seed --class=AdminUserSeeder --force
#
# Nunca dejes una contraseña real en un archivo versionado: esto es una plantilla.
PRODUCT_STUDIO_ADMIN_EMAIL=admin@diesdeplatja.test
PRODUCT_STUDIO_ADMIN_NAME="Administrador técnico"
PRODUCT_STUDIO_ADMIN_PASSWORD=

# Directorio de cache de HTMLPurifier (sanitizado del HTML de contenido).
#
# DEJALO COMENTADO salvo que necesites otra ruta. Ojo: en Laravel una variable
# definida pero VACIA anula el valor por defecto del codigo, no lo hereda. Con
# esta clave puesta y sin valor, HTMLPurifier se queda sin cache y reconstruye
# su definicion en cada peticion (varios segundos por carga). El valor por
# defecto ya es correcto: storage/framework/cache/htmlpurifier
# PRODUCT_STUDIO_PURIFIER_CACHE_PATH=

###############################################################################
# Conexión con Shopify (RFC-0009)
#
# La aplicación se instala por OAuth desde el panel (Configuración -> Conexión
# con Shopify). Aquí sólo van las credenciales de la APLICACIÓN; el access token
# lo entrega Shopify durante la instalación y se guarda CIFRADO en base de datos.
#
# Deja estos valores VACÍOS en el repositorio: son secretos reales de la tienda.
# El resultado de rellenarlos mal se ve en la pantalla de conexión, que explica
# qué falta sin mostrar nunca la credencial.
###############################################################################

# Client ID de la aplicación (Dev Dashboard). Identifica, no autoriza.
SHOPIFY_API_KEY=

# API secret key de la aplicación (empieza por shpss_). Es SECRETA: no se copia a
# Git, ni a un ticket, ni a un chat. NO es un access token y NO se envía en
# X-Shopify-Access-Token: esa cabecera sólo acepta tokens shpat_, que produce el
# flujo OAuth.
SHOPIFY_API_SECRET=

# Dominio de la tienda, terminado en .myshopify.com. Actúa además como guarda: si
# está definido, el callback rechaza una instalación que venga de otra tienda.
SHOPIFY_SHOP_DOMAIN=

# Sólo para una futura distribución pública de la aplicación. Las aplicaciones
# personalizadas (una sola tienda) están exentas de la exigencia de tokens
# expirables, y el refresco automático no está implementado: déjalo en false.
SHOPIFY_OAUTH_EXPIRING=false

# Versión de la API. Shopify retira una versión cada trimestre y, ante una no
# soportada, responde con la más antigua accesible: el contrato dejaría de ser
# predecible. Súbela en cuanto Shopify anuncie el retiro de la actual.
# Versiones vigentes: https://shopify.dev/docs/api/usage/versioning
SHOPIFY_API_VERSION=2026-07

SHOPIFY_TIMEOUT=30
SHOPIFY_CONNECT_TIMEOUT=10

# Reintentos del transporte ante límite de llamadas (429/430) o 5xx.
# Es la primera barrera; la cola añade su propio backoff.
SHOPIFY_RETRY_TIMES=2
SHOPIFY_RETRY_BACKOFF_MS=2000

# Subida de imágenes: son archivos de hasta 20 MB, así que necesitan más margen
# que una consulta normal.
SHOPIFY_UPLOAD_TIMEOUT=120

# Shopify procesa los medios de forma asíncrona: hay que esperar a que el
# archivo esté READY antes de poder asociarlo al producto. Si se agota la
# espera, la sincronización queda reintentable (continúa, no reinicia).
SHOPIFY_MEDIA_POLL_ATTEMPTS=5
SHOPIFY_MEDIA_POLL_SLEEP_MS=1000

# Metafield privado donde se guarda la referencia interna de la ficha. Es lo que
# permite reconocer el producto en Shopify y no duplicarlo en el siguiente envío.
SHOPIFY_METAFIELD_NAMESPACE=product_studio

###############################################################################
# IA mediante OpenRouter (RFC-0003)
#
# La integración real corresponde a RFC-0003. OpenRouter expone una API
# compatible con la de OpenAI, así que el cliente se encapsula detrás de una
# interfaz propia y ninguna pantalla llama al proveedor directamente.
#
# El modelo usa el formato `proveedor/modelo` de OpenRouter, por ejemplo:
#   openai/gpt-4.1
#   anthropic/claude-sonnet-4
#   google/gemini-2.5-pro
# Cambiarlo no requiere tocar código.
#
# La clave se obtiene en https://openrouter.ai/keys y NUNCA se versiona ni se
# guarda en base de datos. No registrar prompts con imágenes ni respuestas
# completas (ver SecretRedactor).
###############################################################################

AI_DRIVER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4.1
OPENROUTER_TIMEOUT=120
OPENROUTER_CONNECT_TIMEOUT=10
OPENROUTER_RETRY_TIMES=2
OPENROUTER_RETRY_BACKOFF_MS=1000
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_TEMPERATURE=0.4

# Cabeceras de atribución de OpenRouter (no son credenciales).
OPENROUTER_APP_NAME="Shopify Product Studio"
OPENROUTER_APP_URL="${APP_URL}"

# Las fotos se reducen antes de enviarse. Mandar originales de 4000 px encarece
# la llamada y alarga la respuesta sin mejorar la descripción.
OPENROUTER_IMAGE_MAX_SIDE=1024
OPENROUTER_IMAGE_QUALITY=80

###############################################################################
# Correo
###############################################################################

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@diesdeplatja.test"
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# Frontend (Vite)
###############################################################################

VITE_APP_NAME="${APP_NAME}"